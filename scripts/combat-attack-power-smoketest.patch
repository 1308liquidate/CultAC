--- /dev/null
+++ b/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/CombatUseServerProbe.java
@@ -0,0 +1,55 @@
+package ac.grim.movementvalidation.packetcontrol;
+
+import io.papermc.paper.event.player.PlayerShieldDisableEvent;
+import io.papermc.paper.event.player.PlayerStopUsingItemEvent;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.entity.EntityDamageEvent;
+import org.bukkit.event.entity.EntityShootBowEvent;
+import org.bukkit.event.player.PlayerItemConsumeEvent;
+import org.bukkit.plugin.java.JavaPlugin;
+
+/** MONITOR observers: read actual server outcomes without modifying any event. */
+final class CombatUseServerProbe implements Listener {
+    private final JavaPlugin plugin;
+
+    CombatUseServerProbe(JavaPlugin plugin) { this.plugin = plugin; }
+
+    private boolean bot(Player player) { return player.getName().startsWith("ChaosBot"); }
+
+    @SuppressWarnings("deprecation")
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onDamage(EntityDamageEvent event) {
+        if (!(event.getEntity() instanceof Player player) || !bot(player)
+                || !event.isApplicable(EntityDamageEvent.DamageModifier.BLOCKING)) return;
+        double blocked = -event.getDamage(EntityDamageEvent.DamageModifier.BLOCKING);
+        if (blocked > 0) plugin.getLogger().info("COMBAT_BLOCK player=" + player.getName()
+                + " blocked=" + blocked + " finalDamage=" + event.getFinalDamage());
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onConsume(PlayerItemConsumeEvent event) {
+        if (bot(event.getPlayer())) plugin.getLogger().info("COMBAT_CONSUME player=" + event.getPlayer().getName()
+                + " item=" + event.getItem().getType().getKey() + " cancelled=" + event.isCancelled());
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onShoot(EntityShootBowEvent event) {
+        if (event.getEntity() instanceof Player player && bot(player)) plugin.getLogger().info(
+                "COMBAT_SHOT player=" + player.getName() + " item=" + event.getBow().getType().getKey()
+                        + " cancelled=" + event.isCancelled() + " force=" + event.getForce());
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onRelease(PlayerStopUsingItemEvent event) {
+        if (bot(event.getPlayer())) plugin.getLogger().info("COMBAT_RELEASE player=" + event.getPlayer().getName()
+                + " item=" + event.getItem().getType().getKey() + " ticks=" + event.getTicksHeldFor());
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onShieldDisable(PlayerShieldDisableEvent event) {
+        if (bot(event.getPlayer())) plugin.getLogger().info("COMBAT_SHIELD_DISABLE player=" + event.getPlayer().getName());
+    }
+}
diff --git a/src/test/java/ac/grim/movementvalidation/AttackPowerMetricsTest.java b/src/test/java/ac/grim/movementvalidation/AttackPowerMetricsTest.java
new file mode 100644
index 0000000..67ea7d6
--- /dev/null
+++ b/src/test/java/ac/grim/movementvalidation/AttackPowerMetricsTest.java
@@ -0,0 +1,88 @@
+package ac.grim.movementvalidation;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class AttackPowerMetricsTest {
+    @Test
+    public void requiresRealCoverageAndAcceptsOnlyContainedPower() {
+        AttackPowerMetrics result = AttackPowerMetrics.analyze(coveredLog());
+        assertTrue(result.summary(), result.passed());
+        assertEquals(128, result.attacks());
+        assertEquals(64, result.exact());
+        assertEquals(64, result.uncertain());
+    }
+
+    @Test
+    public void rejectsMismatchEvenWhenServerLabelsItMatched() {
+        String invalid = coveredLog() + attack("bot0", "minecraft:diamond_axe", 0.2F, 0.91F, 1.0F);
+        AttackPowerMetrics result = AttackPowerMetrics.analyze(invalid);
+        assertFalse(result.passed());
+        assertEquals(1, result.mismatches());
+        assertTrue(result.coverageFailures().isEmpty());
+    }
+
+    @Test
+    public void numericToleranceCannotHideOppositeFullStrengthClassifications() {
+        AttackPowerMetrics result = AttackPowerMetrics.analyze(coveredLog()
+                + attack("bot0", "minecraft:diamond_sword", 0.9F, Math.nextUp(0.9F), 1.0F));
+        assertFalse(result.passed());
+        assertEquals(1, result.mismatches());
+    }
+
+    @Test
+    public void rejectsNanAndProbeErrors() {
+        AttackPowerMetrics result = AttackPowerMetrics.analyze(coveredLog()
+                + attack("bot0", "minecraft:diamond_sword", Float.NaN, 0.0F, 1.0F)
+                + "ATTACK_PROBE_ERROR missing attack sample\n");
+        assertFalse(result.passed());
+        assertEquals(2, result.comparisonFailures().size());
+    }
+
+    @Test
+    public void heldAppleWithActiveShieldDoesNotProveAppleUse() {
+        AttackPowerMetrics result = AttackPowerMetrics.analyze(coveredLog().replace(
+                "item=minecraft:golden_apple\n", "item=minecraft:golden_apple activeItem=minecraft:shield\n"));
+        assertFalse(result.passed());
+        assertTrue(result.coverageFailures().contains("missing actual item use with minecraft:golden_apple"));
+    }
+
+    @Test
+    public void zeroSamplesCannotPass() {
+        AttackPowerMetrics result = AttackPowerMetrics.analyze("");
+        assertFalse(result.passed());
+        assertFalse(result.coverageFailures().isEmpty());
+    }
+
+    private static String coveredLog() {
+        StringBuilder log = new StringBuilder();
+        for (int bot = 0; bot < 8; bot++) {
+            String name = "bot" + bot;
+            log.append("ATTACK_PACKET player=").append(name).append(" command=START_SPRINTING\n");
+            log.append("ATTACK_PACKET player=").append(name).append(" command=STOP_SPRINTING\n");
+            for (int slot = 0; slot < 10; slot++) {
+                log.append("ATTACK_STATE player=").append(name).append(" tick=").append(slot)
+                        .append(" sprint=").append(slot % 2 == 0).append(" use=false slot=")
+                        .append(slot % 9).append(" item=minecraft:air\n");
+            }
+            for (String item : new String[]{"diamond_sword", "diamond_axe", "trident", "diamond_pickaxe"}) {
+                for (int repeat = 0; repeat < 2; repeat++) {
+                    log.append(attack(name, "minecraft:" + item, 0.2F, 0.2F, 0.2F));
+                    log.append(attack(name, "minecraft:" + item, 1.0F, 0.85F, 1.0F));
+                }
+            }
+        }
+        for (String item : new String[]{"honey_bottle", "golden_apple", "bow", "air"}) {
+            log.append("ATTACK_STATE player=bot0 tick=50 sprint=false use=true slot=5 item=minecraft:")
+                    .append(item).append('\n');
+        }
+        log.append("ATTACK_STATE player=bot0 tick=90 sprint=false use=false slot=5 item=minecraft:glass_bottle\n");
+        return log.toString();
+    }
+
+    private static String attack(String player, String item, float power, float min, float max) {
+        return "ATTACK_POWER player=" + player + " tick=1 target=2 item=" + item
+                + " slot=0 client=" + power + " delay=20 sprint=true use=false min=" + min
+                + " max=" + max + " match=true\n";
+    }
+}
diff --git a/src/test/java/ac/grim/movementvalidation/CombatUseMetricsTest.java b/src/test/java/ac/grim/movementvalidation/CombatUseMetricsTest.java
