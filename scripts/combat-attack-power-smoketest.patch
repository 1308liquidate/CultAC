diff --git a/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/AttackPowerServerProbe.java b/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/AttackPowerServerProbe.java
new file mode 100644
index 0000000..98ded25
--- /dev/null
+++ b/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/AttackPowerServerProbe.java
@@ -0,0 +1,227 @@
+package ac.grim.movementvalidation.packetcontrol;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import java.io.ByteArrayInputStream;
+import java.io.DataInputStream;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.UUID;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.protocol.game.GameProtocols;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+
+/** Reads compensated state on the packet owner. Never writes to the anticheat or its inputs. */
+final class AttackPowerServerProbe {
+    private final JavaPlugin plugin;
+    private final int payloadId;
+    private final int attackId;
+    private final int commandId;
+
+    AttackPowerServerProbe(JavaPlugin plugin) {
+        this.plugin = plugin;
+        int[] ids = {-1, -1, -1};
+        GameProtocols.SERVERBOUND_TEMPLATE.details().listPackets((type, id) -> {
+            if (type.id().toString().equals("minecraft:custom_payload")) ids[0] = id;
+            if (type.id().toString().equals("minecraft:attack")) ids[1] = id;
+            if (type.id().toString().equals("minecraft:player_command")) ids[2] = id;
+        });
+        payloadId = ids[0];
+        attackId = ids[1];
+        commandId = ids[2];
+        if (payloadId < 0 || attackId < 0 || commandId < 0) throw new IllegalStateException("Missing vanilla probe packet IDs");
+    }
+
+    void install(Player player) {
+        try {
+            Object handle = player.getClass().getMethod("getHandle").invoke(player);
+            Object listener = field(handle, "connection");
+            Object connection = field(listener, "connection");
+            Channel channel = (Channel) field(connection, "channel");
+            channel.eventLoop().execute(() -> {
+                var context = channel.pipeline().context("cult-decoder");
+                if (context == null) {
+                    plugin.getLogger().severe("ATTACK_PROBE_ERROR missing Cult decoder for " + player.getName());
+                    return;
+                }
+                // Read the original frames before Cult can cancel an attack. A diagnostic payload
+                // precedes its attack/reset and runs on Cult's packet owner, after prior proofs.
+                channel.pipeline().addBefore(context.executor(), "cult-decoder", "attack-power-probe",
+                        new Observer(player.getUniqueId(), player.getName()));
+            });
+        } catch (ReflectiveOperationException failure) {
+            plugin.getLogger().severe("ATTACK_PROBE_ERROR install " + failure);
+        }
+    }
+
+    private final class Observer extends ChannelInboundHandlerAdapter {
+        private final UUID uuid;
+        private final String name;
+        private Observation pending;
+        private Bounds bounds;
+        private boolean active;
+        private String previousState = "";
+
+        Observer(UUID uuid, String name) { this.uuid = uuid; this.name = name; }
+
+        @Override
+        public void channelRead(ChannelHandlerContext context, Object message) throws Exception {
+            try {
+                if (message instanceof ByteBuf raw) {
+                    FriendlyByteBuf input = new FriendlyByteBuf(raw.duplicate());
+                    int id = input.readVarInt();
+                    String payload = id == payloadId ? input.readIdentifier().toString() : "";
+                    if (payload.equals("cult:smoketest_combat_use")) {
+                        byte[] bytes = new byte[input.readableBytes()];
+                        input.readBytes(bytes);
+                        logUse(bytes, name);
+                    } else if (payload.equals("cult:smoketest_attack_power")) {
+                        byte[] bytes = new byte[input.readableBytes()];
+                        input.readBytes(bytes);
+                        Observation sample = decode(bytes);
+                        active = true;
+                        if (sample.tickEnd) {
+                            String state = "sprint=" + sample.sprint + " use=" + sample.use + " slot=" + sample.slot
+                                    + " item=" + sample.item + " activeItem=" + sample.activeItem + " useHand=" + sample.useHand;
+                            if (!state.equals(previousState)) {
+                                plugin.getLogger().info("ATTACK_STATE player=" + name + " tick=" + sample.tick + " " + state);
+                                previousState = state;
+                            }
+                        } else {
+                            if (pending != null) throw new IllegalStateException("Unpaired attack observation");
+                            pending = sample;
+                            bounds = readBounds(uuid);
+                        }
+                    } else if (id == attackId && active) {
+                        int target = input.readVarInt();
+                        if (pending == null || pending.target != target) {
+                            throw new IllegalStateException("Attack has no matching client observation: " + target);
+                        }
+                        boolean match = Float.isFinite(pending.power) && pending.power >= bounds.min - 1e-6F
+                                && pending.power <= bounds.max + 1e-6F;
+                        plugin.getLogger().info("ATTACK_POWER player=" + name + " tick=" + pending.tick
+                                + " target=" + target + " item=" + pending.item + " slot=" + pending.slot
+                                + " client=" + pending.power + " delay=" + pending.delay + " sprint=" + pending.sprint
+                                + " use=" + pending.use + " min=" + bounds.min + " max=" + bounds.max
+                                + " minTicker=" + bounds.minTicker + " maxTicker=" + bounds.maxTicker
+                                + " minDelay=" + bounds.minDelay + " maxDelay=" + bounds.maxDelay
+                                + " match=" + match);
+                        pending = null;
+                    } else if (id == commandId && active) {
+                        input.readVarInt();
+                        var action = input.readEnum(net.minecraft.network.protocol.game.ServerboundPlayerCommandPacket.Action.class);
+                        if (action.name().equals("START_SPRINTING") || action.name().equals("STOP_SPRINTING")) {
+                            plugin.getLogger().info("ATTACK_PACKET player=" + name + " command=" + action.name());
+                        }
+                    }
+                }
+            } catch (Exception failure) {
+                plugin.getLogger().severe("ATTACK_PROBE_ERROR player=" + name + " " + failure);
+            }
+            context.fireChannelRead(message);
+        }
+
+        @Override
+        public void channelInactive(ChannelHandlerContext context) throws Exception {
+            if (pending != null) plugin.getLogger().severe("ATTACK_PROBE_ERROR unpaired observation player=" + name);
+            context.fireChannelInactive();
+        }
+    }
+
+    private static Observation decode(byte[] bytes) throws Exception {
+        try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(bytes))) {
+            if (input.readInt() != 0x41545057 || input.readInt() != 2) throw new IllegalArgumentException("Probe version");
+            Observation result = new Observation(input.readBoolean(), input.readInt(), input.readInt(),
+                    input.readFloat(), input.readFloat(), input.readUTF(), input.readBoolean(), input.readBoolean(), input.readInt(),
+                    input.readUTF(), input.readUTF());
+            if (input.available() != 0) throw new IllegalArgumentException("Trailing probe bytes");
+            return result;
+        }
+    }
+
+    private void logUse(byte[] bytes, String name) throws Exception {
+        try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(bytes))) {
+            if (input.readInt() != 0x43555345 || input.readInt() != 1) throw new IllegalArgumentException("Use probe version");
+            String message = "COMBAT_USE player=" + name + " event=" + input.readUTF() + " sequence=" + input.readLong()
+                    + " tick=" + input.readInt() + " item=" + input.readUTF() + " hand=" + input.readUTF()
+                    + " ticks=" + input.readInt() + " reason=" + input.readUTF();
+            if (input.available() != 0) throw new IllegalArgumentException("Trailing use probe bytes");
+            plugin.getLogger().info(message);
+        }
+    }
+
+    private Bounds readBounds(UUID uuid) throws Exception {
+        var cult = plugin.getServer().getPluginManager().getPlugin("CultAC");
+        if (cult == null) throw new IllegalStateException("CultAC is missing");
+        ClassLoader loader = cult.getClass().getClassLoader();
+        Class<?> apiClass = Class.forName("ac.cult.cultac.CultAPI", false, loader);
+        Object api = apiClass.getField("INSTANCE").get(null);
+        Object manager = call(api, "getPlayerDataManager");
+        Object player = call(manager, "getPlayer", uuid);
+        if (player == null) throw new IllegalStateException("Cult player is missing");
+        // Resolve only the members used by this probe. Enumerating CultPlayer's fields/methods
+        // would also resolve unrelated optional ViaVersion types when Via is not installed.
+        var lookup = java.lang.invoke.MethodHandles.publicLookup();
+        Object strength = readPlayerMember(lookup, player, "attackStrength", "ac.cult.cultac.utils.data.ClientAttackStrength", false);
+        Object attributes = readPlayerMember(lookup, player, "combatAttributes", "ac.cult.cultac.utils.data.ClientCombatAttributes", false);
+        Object inventory = readPlayerMember(lookup, player, "getInventory", "ac.cult.cultac.utils.latency.CompensatedInventory", true);
+        double speed = ((Number) call(attributes, "attackSpeed")).doubleValue();
+        // PacketPlayerAttack uses the bundle-proven attribute; held equipment cannot change it locally.
+        float minDelay = (float) (1.0 / speed * 20.0);
+        float maxDelay = minDelay;
+        int minTicker = ((Number) field(strength, "minTicker")).intValue();
+        int maxTicker = ((Number) field(strength, "maxTicker")).intValue();
+        // PacketPlayerAttack calls onClaimedMainHand before reading strength. Reproduce that read
+        // without mutating it: a different item lowers only the minimum.
+        Object lastItem = field(strength, "lastMainHand");
+        Object heldItem = call(inventory, "getHeldItem");
+        if (!call(lastItem, "itemKey").equals(call(heldItem, "itemKey"))) minTicker = 0;
+        return new Bounds(scale(minTicker, maxDelay), scale(maxTicker, minDelay), minTicker, maxTicker, minDelay, maxDelay);
+    }
+
+    private static Object readPlayerMember(java.lang.invoke.MethodHandles.Lookup lookup, Object player,
+            String name, String typeName, boolean method) throws Exception {
+        Class<?> type = Class.forName(typeName, false, player.getClass().getClassLoader());
+        var handle = method ? lookup.findVirtual(player.getClass(), name, java.lang.invoke.MethodType.methodType(type))
+                : lookup.findGetter(player.getClass(), name, type);
+        try {
+            return handle.invoke(player);
+        } catch (Throwable failure) {
+            throw new IllegalStateException("Cannot read anticheat member " + name, failure);
+        }
+    }
+
+    private static float scale(int ticker, float delay) {
+        return Math.min(Math.max((ticker + 0.5F) / delay, 0.0F), 1.0F);
+    }
+
+    private static Object field(Object instance, String name) throws ReflectiveOperationException {
+        for (Class<?> type = instance.getClass(); type != null; type = type.getSuperclass()) {
+            try {
+                Field field = type.getDeclaredField(name);
+                field.setAccessible(true);
+                return field.get(instance);
+            } catch (NoSuchFieldException ignored) { }
+        }
+        throw new NoSuchFieldException(name);
+    }
+
+    private static Object call(Object instance, String name, Object... arguments) throws ReflectiveOperationException {
+        for (Method method : instance.getClass().getMethods()) {
+            if (!method.getName().equals(name) || method.getParameterCount() != arguments.length) continue;
+            boolean compatible = true;
+            for (int index = 0; index < arguments.length; index++) {
+                if (arguments[index] != null && !method.getParameterTypes()[index].isInstance(arguments[index])) compatible = false;
+            }
+            if (compatible) return method.invoke(instance, arguments);
+        }
+        throw new NoSuchMethodException(name);
+    }
+
+    private record Observation(boolean tickEnd, int tick, int target, float power, float delay,
+                               String item, boolean sprint, boolean use, int slot, String activeItem, String useHand) { }
+    private record Bounds(float min, float max, int minTicker, int maxTicker, float minDelay, float maxDelay) { }
+}
diff --git a/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/CombatUseServerProbe.java b/src/packetControlPlugin/java/ac/grim/movementvalidation/packetcontrol/CombatUseServerProbe.java
new file mode 100644
