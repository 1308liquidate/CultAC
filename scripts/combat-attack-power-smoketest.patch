--- /dev/null
+++ b/src/main/java/ac/grim/movementvalidation/AttackPowerClientProbe.java
@@ -0,0 +1,78 @@
+package ac.grim.movementvalidation;
+
+import java.io.IOException;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.util.function.BiConsumer;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+/** Read-only hook at the vanilla attack boundary. Gameplay instructions remain unchanged. */
+public final class AttackPowerClientProbe {
+    private static final ThreadLocal<BiConsumer<Object, Object>> OBSERVER = new ThreadLocal<>();
+
+    private AttackPowerClientProbe() {}
+
+    static void observe(BiConsumer<Object, Object> observer) {
+        OBSERVER.set(observer);
+    }
+
+    public static void sample(Object player, Object target) {
+        BiConsumer<Object, Object> observer = OBSERVER.get();
+        if (observer == null) throw new IllegalStateException("Attack power observer was not installed");
+        observer.accept(player, target);
+    }
+
+    static final class RuntimeLoader extends URLClassLoader {
+        RuntimeLoader(URL[] urls, ClassLoader parent) { super(urls, parent); }
+
+        @Override
+        protected Class<?> findClass(String name) throws ClassNotFoundException {
+            boolean attack = name.equals("net.minecraft.client.multiplayer.MultiPlayerGameMode");
+            boolean itemUse = name.equals("net.minecraft.client.player.LocalPlayer")
+                    || name.equals("net.minecraft.world.entity.LivingEntity");
+            if (!attack && !itemUse) return super.findClass(name);
+            URL resource = findResource(name.replace('.', '/') + ".class");
+            if (resource == null) throw new ClassNotFoundException(name);
+            try (var input = resource.openStream()) {
+                byte[] original = input.readAllBytes();
+                byte[] transformed = attack ? instrument(original) : CombatUseClientProbe.instrument(name, original);
+                return defineClass(name, transformed, 0, transformed.length);
+            } catch (IOException failure) {
+                throw new ClassNotFoundException(name, failure);
+            }
+        }
+    }
+
+    static byte[] instrument(byte[] original) {
+        ClassWriter writer = new ClassWriter(ClassWriter.COMPUTE_MAXS);
+        int[] hooks = {0};
+        new ClassReader(original).accept(new ClassVisitor(Opcodes.ASM9, writer) {
+            @Override
+            public MethodVisitor visitMethod(int access, String name, String descriptor, String signature, String[] exceptions) {
+                MethodVisitor next = super.visitMethod(access, name, descriptor, signature, exceptions);
+                if (!name.equals("attack") || !descriptor.equals(
+                        "(Lnet/minecraft/world/entity/player/Player;Lnet/minecraft/world/entity/Entity;)V")) return next;
+                return new MethodVisitor(Opcodes.ASM9, next) {
+                    @Override
+                    public void visitMethodInsn(int opcode, String owner, String method, String desc, boolean itf) {
+                        super.visitMethodInsn(opcode, owner, method, desc, itf);
+                        if (method.equals("ensureHasSentCarriedItem") && desc.equals("()V")) {
+                            super.visitVarInsn(Opcodes.ALOAD, 1);
+                            super.visitVarInsn(Opcodes.ALOAD, 2);
+                            super.visitMethodInsn(Opcodes.INVOKESTATIC,
+                                    "ac/grim/movementvalidation/AttackPowerClientProbe", "sample",
+                                    "(Ljava/lang/Object;Ljava/lang/Object;)V", false);
+                            hooks[0]++;
+                        }
+                    }
+                };
+            }
+        }, 0);
+        if (hooks[0] != 1) throw new IllegalStateException("Expected one vanilla attack hook, found " + hooks[0]);
+        return writer.toByteArray();
+    }
+}
