--- /dev/null
+++ b/src/main/java/ac/grim/movementvalidation/CombatUseClientProbe.java
@@ -0,0 +1,67 @@
+package ac.grim.movementvalidation;
+
+import java.util.function.BiConsumer;
+import org.objectweb.asm.*;
+
+/** Observation callbacks only; every original vanilla instruction is preserved. */
+public final class CombatUseClientProbe {
+    private static final ThreadLocal<BiConsumer<Object, String>> OBSERVER = new ThreadLocal<>();
+
+    private CombatUseClientProbe() {}
+
+    static void observe(BiConsumer<Object, String> observer) { OBSERVER.set(observer); }
+
+    public static void sample(Object entity, String event) {
+        var observer = OBSERVER.get();
+        if (observer != null) observer.accept(entity, event);
+    }
+
+    static byte[] instrument(String className, byte[] original) {
+        boolean local = className.endsWith(".LocalPlayer");
+        int[] hooks = {0, 0};
+        ClassWriter writer = new ClassWriter(ClassWriter.COMPUTE_MAXS);
+        new ClassReader(original).accept(new ClassVisitor(Opcodes.ASM9, writer) {
+            @Override
+            public MethodVisitor visitMethod(int access, String name, String descriptor, String signature, String[] exceptions) {
+                MethodVisitor next = super.visitMethod(access, name, descriptor, signature, exceptions);
+                return new MethodVisitor(Opcodes.ASM9, next) {
+                    private void hook(String event, int index) {
+                        super.visitVarInsn(Opcodes.ALOAD, 0);
+                        super.visitLdcInsn(event);
+                        super.visitMethodInsn(Opcodes.INVOKESTATIC,
+                                "ac/grim/movementvalidation/CombatUseClientProbe", "sample",
+                                "(Ljava/lang/Object;Ljava/lang/String;)V", false);
+                        hooks[index]++;
+                    }
+
+                    @Override
+                    public void visitCode() {
+                        super.visitCode();
+                        if (local && name.equals("stopUsingItem") && descriptor.equals("()V")) hook("stop", 1);
+                        if (!local && name.equals("releaseUsingItem") && descriptor.equals("()V")) hook("release", 1);
+                    }
+
+                    @Override
+                    public void visitFieldInsn(int opcode, String owner, String field, String desc) {
+                        super.visitFieldInsn(opcode, owner, field, desc);
+                        if (local && name.equals("startUsingItem") && opcode == Opcodes.PUTFIELD
+                                && field.equals("usingItemHand")) hook("start", 0);
+                    }
+
+                    @Override
+                    public void visitMethodInsn(int opcode, String owner, String method, String desc, boolean itf) {
+                        super.visitMethodInsn(opcode, owner, method, desc, itf);
+                        if (!local && name.equals("completeUsingItem") && method.equals("finishUsingItem")) {
+                            hook("complete", 0);
+                        }
+                    }
+                };
+            }
+        }, 0);
+        if (hooks[0] != 1 || hooks[1] != 1) {
+            throw new IllegalStateException("Expected two vanilla item-use hooks in " + className
+                    + ", got " + hooks[0] + "/" + hooks[1]);
+        }
+        return writer.toByteArray();
+    }
+}
