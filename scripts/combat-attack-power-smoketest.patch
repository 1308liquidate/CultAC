new file mode 100644
index 0000000..d47bedc
--- /dev/null
+++ b/src/main/java/ac/grim/movementvalidation/AttackPowerMetrics.java
@@ -0,0 +1,124 @@
+package ac.grim.movementvalidation;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Separates missing scenario coverage from an observed anticheat mismatch. */
+public record AttackPowerMetrics(int attacks, int exact, int uncertain, int mismatches, int sprintStarts,
+                                int sprintStops, int slotChanges, int sprintStartPackets, int sprintStopPackets, Map<String, Integer> items,
+                                List<String> coverageFailures, List<String> comparisonFailures,
+                                List<String> observations) {
+    public static AttackPowerMetrics analyze(String log) {
+        int attacks = 0, exact = 0, uncertain = 0, mismatches = 0, starts = 0, stops = 0, changes = 0;
+        int startPackets = 0, stopPackets = 0;
+        Map<String, Integer> items = new LinkedHashMap<>();
+        Map<String, Integer> weak = new HashMap<>(), charged = new HashMap<>();
+        Map<String, String> lastSprint = new HashMap<>(), lastSlot = new HashMap<>();
+        Set<String> uses = new HashSet<>(), players = new HashSet<>();
+        boolean consumedHoney = false, sprintWeak = false, sprintCharged = false;
+        List<String> coverage = new ArrayList<>(), comparisons = new ArrayList<>(), observations = new ArrayList<>();
+        for (String line : log.lines().toList()) {
+            int error = line.indexOf("ATTACK_PROBE_ERROR");
+            if (error >= 0) comparisons.add(line.substring(error));
+            int packet = line.indexOf("ATTACK_PACKET ");
+            if (packet >= 0) {
+                String command = fields(line.substring(packet)).get("command");
+                if ("START_SPRINTING".equals(command)) startPackets++;
+                if ("STOP_SPRINTING".equals(command)) stopPackets++;
+                observations.add(line.substring(packet));
+            }
+            int sample = line.indexOf("ATTACK_POWER ");
+            int state = line.indexOf("ATTACK_STATE ");
+            if (sample < 0 && state < 0) continue;
+            String observation = line.substring(sample >= 0 ? sample : state).replaceAll("\\u001B\\[[;\\d]*m", "");
+            observations.add(observation);
+            Map<String, String> fields = fields(observation);
+            String player = fields.get("player"), item = fields.get("item");
+            if (sample >= 0) {
+                attacks++;
+                players.add(player);
+                items.merge(item, 1, Integer::sum);
+                float power = Float.parseFloat(fields.get("client"));
+                float min = Float.parseFloat(fields.get("min"));
+                float max = Float.parseFloat(fields.get("max"));
+                // Check independently of the server's match label; never silently accept NaN or missing bounds.
+                boolean match = Float.isFinite(power) && Float.isFinite(min) && Float.isFinite(max)
+                        && min <= max && power >= min - 1e-6F && power <= max + 1e-6F;
+                // The full-strength decision is strict vanilla float comparison; tolerance must
+                // not turn a value on the opposite side of 0.9F into an accepted match.
+                boolean thresholdCovered = !(min > 0.9F && power <= 0.9F)
+                        && !(max <= 0.9F && power > 0.9F);
+                if (!match || !thresholdCovered || !"true".equals(fields.get("match"))) {
+                    mismatches++;
+                    comparisons.add(observation);
+                } else if (max - min <= 2e-6F) exact++;
+                else uncertain++;
+                (power > 0.9F ? charged : weak).merge(item, 1, Integer::sum);
+                if ("true".equals(fields.get("sprint"))) {
+                    if (power > 0.9F) sprintCharged = true;
+                    else sprintWeak = true;
+                }
+            } else {
+                String sprint = fields.get("sprint");
+                String previous = lastSprint.put(player, sprint);
+                if ("false".equals(previous) && "true".equals(sprint)) starts++;
+                if ("true".equals(previous) && "false".equals(sprint)) stops++;
+                String slot = fields.get("slot");
+                String previousSlot = lastSlot.put(player, slot);
+                if (previousSlot != null && !previousSlot.equals(slot)) changes++;
+                if ("true".equals(fields.get("use"))) uses.add(fields.getOrDefault("activeItem",
+                        item.equals("minecraft:air") ? "minecraft:shield" : item));
+                if (item.equals("minecraft:glass_bottle") && slot.equals("5")) consumedHoney = true;
+            }
+        }
+        if (attacks < 24) coverage.add("fewer than 24 attack samples: " + attacks);
+        if (players.size() < 8) coverage.add("fewer than 8 attacking clients: " + players.size());
+        for (String item : List.of("minecraft:diamond_sword", "minecraft:diamond_axe", "minecraft:trident", "minecraft:diamond_pickaxe")) {
+            if (weak.getOrDefault(item, 0) < 2) coverage.add("missing weak attacks with " + item);
+            if (charged.getOrDefault(item, 0) < 2) coverage.add("missing charged attacks with " + item);
+        }
+        if (starts < 8 || stops < 8) coverage.add("missing actual sprint starts/stops: " + starts + "/" + stops);
+        if (startPackets < 8 || stopPackets < 8) coverage.add("missing START/STOP_SPRINTING packets: " + startPackets + "/" + stopPackets);
+        if (!sprintWeak || !sprintCharged) coverage.add("missing weak/charged sprint attacks");
+        if (changes < 40) coverage.add("fewer than 40 observed slot changes: " + changes);
+        for (String item : List.of("minecraft:honey_bottle", "minecraft:golden_apple", "minecraft:bow", "minecraft:shield")) {
+            if (!uses.contains(item)) coverage.add("missing actual item use with " + item);
+        }
+        if (!consumedHoney) coverage.add("single honey bottle was not consumed into a glass bottle");
+        return new AttackPowerMetrics(attacks, exact, uncertain, mismatches, starts, stops, changes, startPackets, stopPackets,
+                Map.copyOf(items), List.copyOf(coverage), List.copyOf(comparisons), List.copyOf(observations));
+    }
+
+    /** Recheck saved raw server evidence without restarting clients or changing the anticheat. */
+    public static void main(String[] args) throws java.io.IOException {
+        if (args.length != 1) throw new IllegalArgumentException("Expected one raw server log path");
+        AttackPowerMetrics result = analyze(java.nio.file.Files.readString(java.nio.file.Path.of(args[0])));
+        System.out.print(result.summary());
+        if (!result.passed()) System.exit(1);
+    }
+
+    private static Map<String, String> fields(String line) {
+        Map<String, String> fields = new HashMap<>();
+        for (String field : line.split("\\s+")) {
+            int equals = field.indexOf('=');
+            if (equals > 0) fields.put(field.substring(0, equals), field.substring(equals + 1));
+        }
+        return fields;
+    }
+
+    public boolean passed() { return coverageFailures.isEmpty() && comparisonFailures.isEmpty(); }
+
+    public String summary() {
+        return "mode=combat-attack-power-probe\npassed=" + passed() + "\nattacks=" + attacks
+                + "\nexact=" + exact + "\nuncertain=" + uncertain + "\nmismatches=" + mismatches
+                + "\nsprintStarts=" + sprintStarts + "\nsprintStops=" + sprintStops + "\nslotChanges=" + slotChanges
+                + "\nsprintStartPackets=" + sprintStartPackets + "\nsprintStopPackets=" + sprintStopPackets
+                + "\nitems=" + items + "\ncoverageFailures=" + coverageFailures
+                + "\ncomparisonFailures=" + comparisonFailures + "\n";
+    }
+}
