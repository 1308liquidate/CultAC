@@ -0,0 +1,63 @@
+package ac.grim.movementvalidation;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CombatUseMetricsTest {
+    private String completeCapture() {
+        StringBuilder log = new StringBuilder();
+        for (int player = 1; player <= 8; player++) {
+            int sequence = 0;
+            for (String item : new String[]{"honey_bottle", "golden_apple", "bow", "shield"}) {
+                int episodes = item.equals("honey_bottle") || item.equals("golden_apple") ? 2 : 1;
+                for (int episode = 0; episode < episodes; episode++) {
+                    sequence++;
+                    String fields = " player=Bot" + player + " sequence=" + sequence + " item=minecraft:" + item;
+                    log.append("COMBAT_USE event=start").append(fields).append('\n');
+                    log.append("COMBAT_USE event=stop reason=").append(episode == 1 ? "completed" : "released")
+                            .append(fields).append('\n');
+                }
+                if (episodes == 2) {
+                    log.append("COMBAT_CONSUME item=minecraft:").append(item).append(" cancelled=false\n");
