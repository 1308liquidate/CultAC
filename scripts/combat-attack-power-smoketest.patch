@@ -0,0 +1,99 @@
+package ac.grim.movementvalidation;
+
+import java.util.*;
+
+/** Counts client use lifecycles and independently observed server outcomes. */
+public record CombatUseMetrics(Map<String, Integer> attacks, Map<String, Integer> useStarts,
+        Map<String, Integer> consumptions, Map<String, Integer> earlyReleases, int bowShots,
+        int successfulBlocks, int shieldReleases, int interruptedClientUses, List<String> failures) {
+    public static CombatUseMetrics analyze(String log) {
+        Map<String, Integer> attacks = new TreeMap<>(), starts = new TreeMap<>(), consumed = new TreeMap<>(), aborted = new TreeMap<>();
+        Map<String, String> pending = new HashMap<>();
+        Set<String> seen = new HashSet<>();
+        List<String> failures = new ArrayList<>();
+        int shots = 0, blocks = 0, lowered = 0, interrupted = 0;
+        for (String line : log.lines().toList()) {
+            int index = line.indexOf("COMBAT_");
+            if (index < 0) {
+                index = line.indexOf("ATTACK_POWER ");
+                if (index >= 0) increment(attacks, fields(line.substring(index)).get("item"));
+                continue;
+            }
+            String observation = line.substring(index);
+            String type = observation.split("\\s+", 2)[0];
+            Map<String, String> data = fields(observation);
+            String item = data.get("item");
+            switch (type) {
+                case "COMBAT_USE" -> {
+                    String key = data.get("player") + ":" + data.get("sequence");
+                    if ("start".equals(data.get("event"))) {
+                        if (!seen.add(key) || pending.put(key, item) != null) failures.add("Duplicate use start: " + key);
+                        increment(starts, item);
+                    } else if ("stop".equals(data.get("event"))) {
+                        if (!Objects.equals(pending.remove(key), item)) failures.add("Unpaired/mismatched use end: " + key);
+                        if ("interrupted".equals(data.get("reason"))) interrupted++;
+                    }
+                }
+                case "COMBAT_CONSUME" -> {
+                    if ("false".equals(data.get("cancelled"))) increment(consumed, item);
+                    else failures.add("Cancelled server consumption: " + observation);
+                }
+                case "COMBAT_SHOT" -> {
+                    if ("false".equals(data.get("cancelled"))) shots++;
+                    else increment(aborted, item);
+                }
+                case "COMBAT_BLOCK" -> {
+                    double amount = Double.parseDouble(data.get("blocked"));
+                    if (Double.isFinite(amount) && amount > 0) blocks++;
+                    else failures.add("Invalid blocked damage: " + observation);
+                }
+                case "COMBAT_RELEASE" -> {
+                    int ticks = Integer.parseInt(data.get("ticks"));
+                    if (item.equals("minecraft:shield")) lowered++;
+                    else if (item.equals("minecraft:honey_bottle") || item.equals("minecraft:golden_apple")
+                            || item.equals("minecraft:bow") && ticks < 3) increment(aborted, item);
+                }
+                default -> { }
+            }
+        }
+        if (!pending.isEmpty()) failures.add("Unfinished client use episodes: " + pending.keySet());
+        for (String item : List.of("minecraft:honey_bottle", "minecraft:golden_apple", "minecraft:bow", "minecraft:shield")) {
+            if (starts.getOrDefault(item, 0) < 8) failures.add("Missing actual use starts: " + item);
+        }
+        for (String item : List.of("minecraft:honey_bottle", "minecraft:golden_apple")) {
+            if (consumed.getOrDefault(item, 0) < 8) failures.add("Missing completed consumption: " + item);
+            if (aborted.getOrDefault(item, 0) < 8) failures.add("Missing cancelled food use: " + item);
+        }
+        if (shots < 8) failures.add("Missing successful bow shots");
+        if (blocks < 1) failures.add("No successful shield blocks");
+        return new CombatUseMetrics(Map.copyOf(attacks), Map.copyOf(starts), Map.copyOf(consumed), Map.copyOf(aborted),
+                shots, blocks, lowered, interrupted, List.copyOf(failures));
+    }
+
+    private static void increment(Map<String, Integer> values, String key) { values.merge(key, 1, Integer::sum); }
+
+    private static Map<String, String> fields(String line) {
+        Map<String, String> result = new HashMap<>();
+        for (String value : line.split("\\s+")) {
+            int equals = value.indexOf('=');
+            if (equals > 0) result.put(value.substring(0, equals), value.substring(equals + 1));
+        }
+        return result;
+    }
+
+    public boolean passed() { return failures.isEmpty(); }
+
+    public String summary() {
+        return "mode=combat-use-probe\npassed=" + passed() + "\nattacks=" + new TreeMap<>(attacks)
+                + "\nuseStarts=" + new TreeMap<>(useStarts) + "\nconsumptions=" + new TreeMap<>(consumptions)
+                + "\nearlyReleases=" + new TreeMap<>(earlyReleases) + "\nbowShots=" + bowShots
+                + "\nsuccessfulBlocks=" + successfulBlocks + "\nshieldReleases=" + shieldReleases
+                + "\ninterruptedClientUses=" + interruptedClientUses + "\nfailures=" + failures + "\n";
+    }
+
+    public static void main(String[] args) throws java.io.IOException {
+        CombatUseMetrics result = analyze(java.nio.file.Files.readString(java.nio.file.Path.of(args[0])));
+        System.out.print(result.summary());
+        if (!result.passed()) System.exit(1);
+    }
+}
